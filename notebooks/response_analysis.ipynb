 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Response Analysis Notebook\n",
    "Analyze and evaluate LLM responses for email processing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.append('..')\n",
    "\n",
    "from src.llm.openai_client import OpenAIClient\n",
    "from src.llm.utils import count_tokens, estimate_cost\n",
    "from utils.token_counter import TokenCounter\n",
    "from config.config_loader import get_model_config\n",
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "config = get_model_config()\n",
    "azure_config = config.get(\"azure_openai\", {})\n",
    "\n",
    "client = OpenAIClient(\n",
    "    api_key=azure_config.get(\"api_key\"),\n",
    "    model=azure_config.get(\"chat_model\", {}).get(\"deployment_name\"),\n",
    "    use_azure=True,\n",
    "    azure_endpoint=azure_config.get(\"endpoint\")\n",
    ")\n",
    "\n",
    "token_counter = TokenCounter()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Analyze Response Quality"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test prompts\n",
    "test_prompts = [\n",
    "    \"Classify this email: Subject: Happy Birthday! Body: Wishing you a great day!\",\n",
    "    \"Draft a professional meeting request email.\",\n",
    "    \"Summarize this email in one sentence: [long email text]\"\n",
    "]\n",
    "\n",
    "results = []\n",
    "\n",
    "for prompt in test_prompts:\n",
    "    # Count input tokens\n",
    "    input_tokens = count_tokens(prompt, model=\"gpt-4\")\n",
    "    \n",
    "    # Generate response\n",
    "    response = client.generate(prompt, temperature=0.7, max_tokens=200)\n",
    "    \n",
    "    # Count output tokens\n",
    "    output_tokens = count_tokens(response, model=\"gpt-4\")\n",
    "    \n",
    "    # Track tokens\n",
    "    token_counter.add_request(\"gpt-4\", input_tokens, output_tokens)\n",
    "    \n",
    "    # Calculate cost\n",
    "    cost = estimate_cost(input_tokens, output_tokens, \"gpt-4\")\n",
    "    \n",
    "    results.append({\n",
    "        \"prompt\": prompt[:50] + \"...\",\n",
    "        \"response_length\": len(response),\n",
    "        \"input_tokens\": input_tokens,\n",
    "        \"output_tokens\": output_tokens,\n",
    "        \"total_tokens\": input_tokens + output_tokens,\n",
    "        \"cost_usd\": cost\n",
    "    })\n",
    "\n",
    "# Display results\n",
    "df = pd.DataFrame(results)\n",
    "df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Token Usage Statistics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get overall statistics\n",
    "stats = token_counter.get_stats()\n",
    "print(\"Overall Statistics:\")\n",
    "print(f\"Total Requests: {stats['total_requests']}\")\n",
    "print(f\"Total Input Tokens: {stats['total_input_tokens']}\")\n",
    "print(f\"Total Output Tokens: {stats['total_output_tokens']}\")\n",
    "print(f\"Total Tokens: {stats['total_tokens']}\")\n",
    "\n",
    "# Estimate total cost\n",
    "total_cost = token_counter.estimate_cost(\"gpt-4\")\n",
    "print(f\"\\nEstimated Total Cost: ${total_cost:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Response Time Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import time\n",
    "\n",
    "# Measure response times\n",
    "response_times = []\n",
    "\n",
    "for i in range(5):\n",
    "    prompt = f\"Generate a short email greeting (test {i+1})\"\n",
    "    \n",
    "    start_time = time.time()\n",
    "    response = client.generate(prompt, temperature=0.7, max_tokens=50)\n",
    "    end_time = time.time()\n",
    "    \n",
    "    response_time = end_time - start_time\n",
    "    response_times.append(response_time)\n",
    "    \n",
    "    print(f\"Request {i+1}: {response_time:.2f}s\")\n",
    "\n",
    "# Statistics\n",
    "import numpy as np\n",
    "print(f\"\\nAverage Response Time: {np.mean(response_times):.2f}s\")\n",
    "print(f\"Min Response Time: {np.min(response_times):.2f}s\")\n",
    "print(f\"Max Response Time: {np.max(response_times):.2f}s\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Compare Different Temperatures"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "prompt = \"Write a professional email subject line for a meeting request.\"\n",
    "temperatures = [0.3, 0.5, 0.7, 0.9]\n",
    "\n",
    "print(\"Comparing different temperatures:\\n\")\n",
    "for temp in temperatures:\n",
    "    response = client.generate(prompt, temperature=temp, max_tokens=50)\n",
    "    print(f\"Temperature {temp}: {response}\")\n",
    "    print(\"-\" * 50)"
   ]
  }
