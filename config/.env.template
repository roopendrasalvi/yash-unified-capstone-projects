# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# Azure OpenAI Configuration
# ============================================
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-api-key
DEPLOYMENT_NAME=your-deployment-name
API_VERSION=2024-05-01-preview

# ============================================
# Google AI Configuration
# ============================================
GOOGLE_API_KEY=your-google-api-key

# ============================================
# Pinecone Configuration
# ============================================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1

# ============================================
# Milvus Configuration
# ============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=email_collection
MILVUS_DIMENSION=768

# ============================================
# Database Configuration (PostgreSQL/Supabase)
# ============================================
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-database-user
DB_PASSWORD=your-database-password

# ============================================
# Gmail OAuth Configuration
# ============================================
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_PROJECT_ID=your-project-id

# ============================================
# Outlook OAuth Configuration
# ============================================
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_TENANT_ID=your-tenant-id

# ============================================
# AWS S3 Configuration
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_REGION=us-east-1
S3_LOG_BUCKET_NAME=your-s3-log-bucket-name
S3_BACKUP_BUCKET_NAME=your-s3-backup-bucket-name

# ============================================
# CloudFront Configuration (Optional)
# ============================================
CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id
CLOUDFRONT_DOMAIN_NAME=your-cloudfront-domain-name

# ============================================
# Redis Configuration (Optional)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ============================================
# Application Security
# ============================================
SECRET_KEY=your-secret-key-for-jwt-tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Application Settings
# ============================================
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# Streamlit Settings
# ============================================
STREAMLIT_PORT=8051
STREAMLIT_API_URL=http://127.0.0.1:8000

